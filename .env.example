# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Port du serveur
PORT=3001

# Token admin (waitlist, ingestion) — OBLIGATOIRE.
# Le serveur refuse de démarrer si cette variable est absente : sans elle,
# /api/admin/list renvoie l'identité, l'email et la ville de tous les inscrits.
ADMIN_TOKEN=change-moi-en-prod

# Authentification JWT — OBLIGATOIRE.
# Le serveur refuse de démarrer si cette variable est absente : un secret connu
# permet de forger un jeton valable pour n'importe quel compte médecin.
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=7d

# Uniquement pour le poste de développement : autorise le démarrage avec les
# secrets par défaut. Ne jamais définir ailleurs qu'en local.
# ARKIBA_ALLOW_DEV_SECRETS=1

# Nombre de proxys de confiance devant l'application (Railway : 1).
# Sert à résoudre l'IP réelle du client pour la limitation de débit.
# TRUST_PROXY=1

# SMTP Gmail (utilise un App Password, pas ton mot de passe Google)
# Le serveur retire automatiquement les espaces du SMTP_PASS (App Password = 16 caractères).
SMTP_USER=studioarkenpro@gmail.com
SMTP_PASS=ton-app-password-gmail

# URL publique de l'application (pour les liens dans les emails)
# ⚠ Sur Railway : mets l'URL publique du service, ex. https://www.arkiba.fr
APP_URL=http://localhost:3001

# Dossier de stockage des données (waitlist.json / users.json / dossiers.json).
# ⚠ Sur Railway : le disque est éphémère. Monte un volume (ex. /data) et définis
# DATA_DIR=/data.
# dossiers.json contient les fiches patients et tous les documents générés :
# sans volume, ces données médicales sont perdues à chaque redéploiement.
# Contrôle après déploiement : GET /health → stockage.persistant doit valoir true.
# DATA_DIR=/data

# ── Avis spécialisé / RAG ─────────────────────────────────────────────────────

# Embeddings Voyage AI — https://dash.voyageai.com/
# Sans cette clé, l'index reste purement lexical (BM25) : la recherche fonctionne
# mais en mode dégradé. Recommandé pour la qualité des passages retrouvés.
VOYAGE_API_KEY=pa-...
# Modèle d'embeddings (défaut : voyage-3.5, multilingue, 1024 dimensions)
# VOYAGE_MODEL=voyage-3.5

# Dossier de l'index vectoriel. Par défaut : <DATA_DIR>/rag
# ⚠ Sur Railway : doit pointer dans le volume persistant, sinon l'index est perdu
# à chaque redéploiement et il faut relancer l'ingestion.
# RAG_DIR=/data/rag

# Clé NCBI (facultative) — fait passer PubMed de 3 à 10 requêtes/seconde.
# Utile uniquement pendant l'ingestion. https://account.ncbi.nlm.nih.gov/settings/
# NCBI_API_KEY=
